    def build_map_page(self):
        page, layout = self.make_page(compact=True)
        self.page_widgets["mapa"] = page

        intro, intro_layout = self.create_card(
            "🌍 Mapa meteorológico", compact=True
        )

        description = QLabel(
            "Explorá el mundo, compará condiciones y consultá "
            "el pronóstico de distintas ubicaciones."
        )
        description.setWordWrap(True)
        intro_layout.addWidget(description)
        layout.addWidget(intro)

        controls, controls_layout = self.create_card(
            "Capas del mapa", compact=True
        )

        self.map_layer_label = QLabel(
            "Capa seleccionada: Precipitación"
        )
        self.map_layer_label.setProperty("muted", True)

        self.map_layer_buttons = {}
        row = QGridLayout()

        for index, (key, label) in enumerate((
            ("rain", "🌧️ Precipitación"),
            ("temp", "🌡️ Temperatura"),
            ("wind", "🌬️ Viento"),
            ("air", "🌫️ Calidad del aire"),
            ("quakes", "🌎 Sismos"),
        )):
            button = QPushButton(label)
            button.setCheckable(True)
            button.setChecked(index == 0)
            button.clicked.connect(
                lambda checked=False, k=key, name=label:
                self.select_map_layer(k, name)
            )
            row.addWidget(button, index // 2, index % 2)
            self.map_layer_buttons[key] = button

        controls_layout.addLayout(row)
        controls_layout.addWidget(self.map_layer_label)
        layout.addWidget(controls)

        map_card, map_layout = self.create_card(
            "Vista del mapa", compact=True
        )

        map_notice = QLabel(
            "El mapa nativo todavía no está integrado.\n\n"
            "Las capas meteorológicas deberán reutilizar los datos "
            "y servicios de Clima G. La capa de sismos utilizará "
            "la fuente USGS aprobada por el proyecto.\n\n"
            "No se muestran datos simulados ni capas de proveedores "
            "meteorológicos adicionales."
        )
        map_notice.setWordWrap(True)
        map_notice.setAlignment(
            Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter
        )
        map_notice.setStyleSheet("""
            QLabel {
                background: #eef2f8;
                border-radius: 12px;
                padding: 10px;
                color: #334155;
            }
        """)

        map_layout.addWidget(map_notice)
        layout.addWidget(map_card)

    def select_map_layer(self, key, label):
        for name, button in self.map_layer_buttons.items():
            button.setChecked(name == key)

        self.map_layer_label.setText(
            f"Capa seleccionada: {label}"
        )

