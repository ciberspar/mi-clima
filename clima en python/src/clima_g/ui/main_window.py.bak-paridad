    # PESTAÑA HOY
    # ---------------------------------------------------------

    def build_today_page(self):
        page, layout = self.make_page()
        self.page_widgets["hoy"] = page

        # Pronóstico horario
        hourly_card, hourly_layout = self.create_card(
            "Pronóstico por horas"
        )

        self.hourly_description = QLabel("Temperatura")
        self.hourly_description.setProperty("muted", True)
        hourly_layout.addWidget(self.hourly_description)

        self.hourly_scroll = QScrollArea()
        self.hourly_scroll.setWidgetResizable(True)
        self.hourly_scroll.setHorizontalScrollBarPolicy(
            Qt.ScrollBarPolicy.ScrollBarAsNeeded
        )
        self.hourly_scroll.setVerticalScrollBarPolicy(
            Qt.ScrollBarPolicy.ScrollBarAlwaysOff
        )
        self.hourly_scroll.setFixedHeight(125)

        self.hourly_content = QWidget()
        self.hourly_row = QHBoxLayout(self.hourly_content)
        self.hourly_row.setContentsMargins(2, 2, 2, 8)
        self.hourly_row.setSpacing(9)

        self.hourly_scroll.setWidget(self.hourly_content)
        hourly_layout.addWidget(self.hourly_scroll)

        layout.addWidget(hourly_card)

        # Astronomía
        astronomy_card, astronomy_layout = self.create_card(
            "🌙 Astronomía"
        )

        self.moon_phase_label = QLabel("Fase lunar: --")
        self.moon_illumination_label = QLabel("Iluminación aproximada: --")
        self.moonrise_label = QLabel("Salida de Luna: --")
        self.moonset_label = QLabel("Puesta de Luna: --")
        self.sunrise_label = QLabel("Salida del Sol: --")
        self.sunset_label = QLabel("Puesta del Sol: --")

        for label in (
            self.moon_phase_label,
            self.moon_illumination_label,
            self.moonrise_label,
            self.moonset_label,
            self.sunrise_label,
            self.sunset_label,
        ):
            astronomy_layout.addWidget(label)

        layout.addWidget(astronomy_card)

        # Condiciones actuales
        metrics_card, metrics_layout = self.create_card(
            "Condiciones actuales"
        )

        grid = QGridLayout()
        grid.setSpacing(9)

        self.metric_labels = {}
        metrics = [
            ("feels", "Sensación térmica"),
            ("humidity", "Humedad"),
            ("wind", "Viento"),
            ("direction", "Dirección"),
            ("maxmin", "Máx. / Mín."),
            ("precip", "Precipitación"),
            ("pressure", "Presión"),
            ("uv", "Índice UV"),
            ("clouds", "Nubosidad"),
        ]

        for index, (key, label) in enumerate(metrics):
            self.metric_labels[key] = self.add_metric(
                grid, index, label
            )

        metrics_layout.addLayout(grid)
        layout.addWidget(metrics_card)

        self.alert_card, alert_layout = self.create_card(
            "⚠️ Alertas meteorológicas"
        )
        self.alert_label = QLabel(
            "Esperando datos meteorológicos..."
        )
        self.alert_label.setWordWrap(True)
        alert_layout.addWidget(self.alert_label)
        layout.addWidget(self.alert_card)

        layout.addWidget(
            self.make_action_button(
                "↻ Actualizar clima", self.refresh_weather
            )
        )

