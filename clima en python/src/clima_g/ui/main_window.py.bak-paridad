"""Ventana principal nativa de Clima G."""

from datetime import datetime
import math

from PyQt6.QtCore import Qt, QThread, pyqtSignal
from PyQt6.QtWidgets import (
    QWidget, QLabel, QPushButton, QVBoxLayout, QHBoxLayout,
    QGridLayout, QFrame, QScrollArea, QStackedWidget,
    QSizePolicy, QMessageBox
)

from clima_g.config import APP_NAME, APP_VERSION, DEFAULT_LOCATION
from clima_g.services.weather import WeatherService, WeatherError
from clima_g.services.weather_codes import describe_weather
from clima_g.services.baco import generar_decreto
from clima_g.ui.components.weather_header import WeatherHeader


class WeatherWorker(QThread):
    """Consulta meteorológica fuera del hilo de interfaz."""

    data_ready = pyqtSignal(dict)
    error = pyqtSignal(str)

    def __init__(self, latitude, longitude):
        super().__init__()
        self.latitude = latitude
        self.longitude = longitude

    def run(self):
        try:
            service = WeatherService()
            result = service.get_complete_weather(
                self.latitude, self.longitude
            )
            self.data_ready.emit(result)
        except (WeatherError, ValueError) as exc:
            self.error.emit(str(exc))
        except Exception as exc:
            self.error.emit(f"Error inesperado: {exc}")


class MainWindow(QWidget):
    TABS = ("hoy", "semana", "aire", "mapa", "resumen")

    def __init__(self):
        super().__init__()

        self.worker = None
        self.weather_data = None
        self.latitude = DEFAULT_LOCATION["latitude"]
        self.longitude = DEFAULT_LOCATION["longitude"]
        self.location_name = DEFAULT_LOCATION["name"]

        self.setWindowTitle(f"{APP_NAME} {APP_VERSION}")
        self.resize(520, 900)
        self.setMinimumSize(360, 620)

        self.init_ui()
        self.refresh_weather()

    def init_ui(self):
        self.setStyleSheet("""
            QWidget {
                background: #eef2f8;
                color: #12203a;
                font-family: sans-serif;
                font-size: 13px;
            }

            QScrollArea {
                border: none;
                background: transparent;
            }

            QFrame[card="true"] {
                background: white;
                border: 1px solid #cbd5e1;
                border-radius: 16px;
            }

            QLabel[sectionTitle="true"] {
                color: #12203a;
                font-size: 15px;
                font-weight: 700;
            }

            QLabel[muted="true"] {
                color: #64748b;
                font-size: 12px;
            }

            QLabel[metricValue="true"] {
                color: #12203a;
                font-size: 19px;
                font-weight: 700;
            }

            QPushButton {
                background: #1c2a4f;
                color: white;
                border: none;
                border-radius: 10px;
                padding: 9px 13px;
                font-weight: 600;
            }

            QPushButton:hover {
                background: #33507f;
            }

            QPushButton:disabled {
                background: #94a3b8;
            }
        """)

        outer = QVBoxLayout(self)
        outer.setContentsMargins(0, 0, 0, 0)

        scroll = QScrollArea()
        scroll.setWidgetResizable(True)

        content = QWidget()
        content.setStyleSheet("background: #eef2f8;")

        layout = QVBoxLayout(content)
        layout.setContentsMargins(0, 0, 0, 18)
        layout.setSpacing(0)

        self.header = WeatherHeader()
        self.header.city_requested.connect(self.show_cities_info)
        self.header.settings_requested.connect(self.show_settings_info)
        self.header.tab_changed.connect(self.change_tab)
        layout.addWidget(self.header)

        self.pages = QStackedWidget()
        self.pages.setStyleSheet("background: #eef2f8;")

        self.page_widgets = {}
        self.build_today_page()
        self.build_week_page()
        self.build_air_page()
        self.build_map_page()
        self.build_summary_page()

        for key in self.TABS:
            self.pages.addWidget(self.page_widgets[key])

        layout.addWidget(self.pages)

        self.status_label = QLabel("Preparando Clima G...")
        self.status_label.setProperty("muted", True)
        self.status_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.status_label.setContentsMargins(12, 10, 12, 10)
        layout.addWidget(self.status_label)

        footer = QLabel(
            f"Clima G {APP_VERSION} · Datos meteorológicos de Open-Meteo"
        )
        footer.setProperty("muted", True)
        footer.setAlignment(Qt.AlignmentFlag.AlignCenter)
        footer.setContentsMargins(8, 4, 8, 12)
        layout.addWidget(footer)

        scroll.setWidget(content)
        outer.addWidget(scroll)

        self.change_tab("hoy")

    # ---------------------------------------------------------
    # COMPONENTES NATIVOS
    # ---------------------------------------------------------

    def make_page(self, compact=False):
        page = QWidget()
        page.setStyleSheet("background: #eef2f8;")

        layout = QVBoxLayout(page)
        if compact:
            layout.setContentsMargins(12, 10, 12, 12)
            layout.setSpacing(9)
        else:
            layout.setContentsMargins(18, 18, 18, 22)
            layout.setSpacing(14)

        return page, layout

    def create_card(self, title, compact=False):
        card = QFrame()
        card.setProperty("card", True)

        layout = QVBoxLayout(card)
        if compact:
            layout.setContentsMargins(12, 10, 12, 10)
            layout.setSpacing(7)
        else:
            layout.setContentsMargins(16, 14, 16, 16)
            layout.setSpacing(11)

        heading = QLabel(title)
        heading.setProperty("sectionTitle", True)
        layout.addWidget(heading)

        return card, layout

    def add_metric(self, grid, index, title, value="--", compact=False):
        cell = QFrame()
        cell.setStyleSheet("""
            QFrame {
                background: #eef2f8;
                border: none;
                border-radius: 12px;
            }
        """)

        box = QVBoxLayout(cell)
        if compact:
            box.setContentsMargins(8, 6, 8, 6)
            box.setSpacing(3)
        else:
            box.setContentsMargins(10, 10, 8, 10)
            box.setSpacing(5)

        name = QLabel(title)
        name.setProperty("muted", True)

        result = QLabel(value)
        result.setProperty("metricValue", True)
        result.setWordWrap(True)

        box.addWidget(name)
        box.addWidget(result)

        grid.addWidget(cell, index // 3, index % 3)
        return result

    def make_action_button(self, text, callback):
        button = QPushButton(text)
        button.clicked.connect(callback)
        return button

    def change_tab(self, tab):
        if tab not in self.page_widgets:
            return

        self.pages.setCurrentWidget(self.page_widgets[tab])

    def show_cities_info(self):
        QMessageBox.information(
            self,
            "Mis ciudades",
            "La selección y administración de ciudades "
            "se integrará con el servicio de geocodificación de Clima G."
        )

    def show_settings_info(self):
        QMessageBox.information(
            self,
            "Configuración",
            "El panel de configuración nativo está pendiente de integración."
        )

